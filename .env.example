# Copy to .env beside compose.yaml and fill in. .env is gitignored and must
# never be committed; this example holds placeholders only.
#
# A password without characters that need escaping in a connection address:
#     openssl rand -hex 24

POSTGRES_USER=psells
POSTGRES_PASSWORD=change-me
POSTGRES_DB=psells

# The configuration file mounted read-only into the app container, holding the
# default partner percentage. The real one is ./data/config.json; the invented
# one is ./sample_data/config.json. Relative to this folder.
PSELLS_CONFIG_FILE=./data/config.json
