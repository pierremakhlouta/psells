# Copy to .env beside compose.yaml and fill in. .env is gitignored and must
# never be committed; this example holds placeholders only.
#
# A password without characters that need escaping in a connection address:
#     openssl rand -hex 24

POSTGRES_USER=psells
POSTGRES_PASSWORD=change-me
POSTGRES_DB=psells

# The folder mounted at /data in the app container: a SQLite database named
# psells.db and a config.json. Absolute path. Use the sample folder the README
# builds, never the real data/ folder.
PSELLS_DATA_DIR=/tmp/psells-sample
