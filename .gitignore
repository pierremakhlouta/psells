# macOS
.DS_Store

# Python

venv/

__pycache__/

*.pyc

# PSells real data (keep costs/margins out of the repo)
# The whole folder, no exceptions. Prices, margins and the partner rate live
# here, and a rule that lists file extensions has to be remembered every time a
# new one appears, which it was not when the database arrived. Sample data lives
# in sample_data/ and is copied into place.

data/

.vscode/

.pytest_cache/

# Compose settings, including the database password. .env.example is the
# committed template.

.env

# Terraform's working files. State holds every value of every resource in plain
# text, and the bootstrap's state stays on the machine that made the bucket;
# infra/aws/'s own state lives in S3. The lock file, which pins the providers'
# exact builds, is committed.

.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Values that are personal, such as the address the budget's alerts go to.

*.tfvars
